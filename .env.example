# Copia este archivo a ~/.config/jarvis/jarvis.env (chmod 600). server.mjs y whoop.mjs lo leen al arrancar.
# Se aceptan comillas y comentarios al final de la línea. Nunca subas valores reales al repo.
# Claude NO recibe ninguna de estas variables: solo HOME, PATH, LANG, TZ y CLAUDE_CODE_OAUTH_TOKEN.

# --- Claude Code (plan Max) ---
CLAUDE_CODE_OAUTH_TOKEN=          # sale de: claude setup-token (en el servidor, como el usuario jarvis)
# CLAUDE_BIN=/home/jarvis/.local/bin/claude
# CLAUDE_MODEL=opus               # conversar contigo y escribir el reporte/revisiones
# CLAUDE_MODEL_FONDO=sonnet       # tareas de fondo (prep de dailys y acuerdos, Fase 2)
# CLAUDE_TIMEOUT_MS=600000

# --- Kapso (WhatsApp) ---
KAPSO_API_KEY=                    # Kapso → proyecto → API keys
KAPSO_WEBHOOK_SECRET=             # openssl rand -hex 32 (el mismo valor en el webhook de Kapso)
KAPSO_PHONE_NUMBER_ID=            # phone_number_id del número del bot en Kapso
PING_TEMPLATE=jarvis_ping         # plantilla aprobada por Meta, SIN variables (ver README)
PING_TEMPLATE_LANG=es
PING_MAX_DIA=2                    # pings máximos por día cuando la ventana de 24 h está cerrada

# --- Tú ---
OWNER_PHONE=351900000000          # tu WhatsApp, solo dígitos. Cualquier otro número se ignora
OWNER_NAME=Moisés
MEMORIA_PATH=/home/jarvis/jarvis-memoria   # clon de jarvis-memoria: el cwd de Claude
GIT_SYNC=1                        # pull antes y push después de cada mensaje (0 = solo commits locales)

# --- Horarios (el onboarding los ajusta con tus respuestas; estos son los valores por defecto) ---
TZ_DEFAULT=Europe/Lisbon          # zona inicial; cambia con "/zona America/Bogota", "estoy en Bogotá" o al aterrizar
SILENCIO_INICIO=23:00             # silencio nocturno: no escribe por iniciativa propia
SILENCIO_FIN=07:00
REPORTE_FALLBACK=09:00            # hora del reporte si no le escribes antes
CIERRE_ANTES_MIN=30               # el cierre del día llega N minutos antes del silencio
REVISION_SEMANAL_DIA=7            # ISO: 7 = domingo
REVISION_SEMANAL_HORA=18:00
RECORDATORIO_MIN=5                # aviso antes de cada evento
LIMITE_ABIERTOS=5                 # compromisos abiertos máximos
# SILENCIO_IGNORAR=^Bloque|^Foco  # regex: eventos que NO silencian (por defecto, cualquier evento en curso silencia)
# RECORDATORIOS=0                 # apaga el reloj (reporte, avisos, cierre, revisiones)

# --- Negocios y dailys ---
# Cómo se agrupa la agenda: el título de cada evento se compara con "claves" (regex, sin distinguir mayúsculas).
# NEGOCIOS=[{"id":"antoecom","nombre":"AntoEcom","claves":"anto ?ecom|\\banto\\b"},{"id":"imperio-yt","nombre":"Imperio YT","claves":"imperio|\\byt\\b"},{"id":"fiama","nombre":"Fiama","claves":"fiama"},{"id":"congruence","nombre":"Congruence","claves":"congruence"}]
DAILY_REGEX=daily|diaria|stand ?up   # regla para detectar dailys (prep de Fase 2)

# --- Números (Fase 2; se preguntará la fuente real antes de conectar) ---
# NUMEROS_FUENTE=demo             # demo | sheets
# NUMEROS_SHEETS_CSV_ANTOECOM=    # URL de Google Sheets publicado como CSV
# NUMEROS_SHEETS_CSV_IMPERIO_YT=
# NUMEROS_SHEETS_CSV_FIAMA=

# --- Google Calendar (el bridge lo lee y escribe; Claude no) ---
GOOGLE_CLIENT_ID=                 # Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU-HOST/google/callback
# AGENDA_CALENDARS=tu@gmail.com,otro@empresa.com   # calendarios a leer (por defecto: el principal)
# CALENDARIO_ESCRITURA=primary                     # donde crea y mueve bloques

# --- WHOOP (opcional) ---
WHOOP_CLIENT_ID=                  # developer.whoop.com → tu app
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://TU-HOST/whoop/callback

# --- HUD /jarvis (Fase 3 lo completa) ---
JARVIS_TOKEN=                     # openssl rand -hex 24. Se abre una vez /jarvis/?k=<token> y queda guardado en el navegador
# JARVIS_WAKE_LINE=Buenos días, JARVIS.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_FAST_MODEL=eleven_v4_turbo

# --- Pruebas ---
# DRY_RUN=1                       # no manda WhatsApp ni toca el calendario: lo imprime en consola
# PORT=8787
